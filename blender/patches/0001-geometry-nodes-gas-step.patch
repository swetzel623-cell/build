diff --git a/intern/mantaflow/extern/manta_gas_step_API.h b/intern/mantaflow/extern/manta_gas_step_API.h
new file mode 100644
--- /dev/null
+++ b/intern/mantaflow/extern/manta_gas_step_API.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstddef>
+#include <string>
+
+namespace blender {
+
+struct MantaGasExtent3 {
+  int x = 0;
+  int y = 0;
+  int z = 0;
+};
+
+struct MantaGasVec3 {
+  float x = 0.0f;
+  float y = 0.0f;
+  float z = 0.0f;
+};
+
+/**
+ * Borrowed dense grid buffers in Mantaflow's X-fastest layout.
+ *
+ * Velocity is cell-centered and measured in grid cells per second at this API boundary. The
+ * implementation converts it to Mantaflow's internal MAC layout. Pressure is both an input and an
+ * output so the serializable state can retain the previous pressure field as an initial guess.
+ */
+struct MantaGasState {
+  MantaGasExtent3 resolution;
+  float *density = nullptr;
+  float *temperature = nullptr;
+  MantaGasVec3 *velocity = nullptr;
+  float *pressure = nullptr;
+};
+
+struct MantaGasStepSettings {
+  /* Frame time and internal substeps are measured in seconds. */
+  float delta_time = 1.0f / 30.0f;
+  float cfl = 2.0f;
+  int max_substeps = 32;
+
+  /* Grid-space acceleration in cells per second squared, used only for buoyancy. */
+  MantaGasVec3 gravity = {0.0f, 0.0f, -9.81f};
+  float density_buoyancy = 0.0f;
+  float heat_buoyancy = 1.0f;
+
+  float pressure_accuracy = 1.0e-3f;
+  float pressure_iteration_factor = 1.5f;
+};
+
+struct MantaGasStepDiagnostics {
+  int substeps = 0;
+  float simulated_time = 0.0f;
+  /* Largest MAC velocity norm sampled by the CFL scheduler, in cells per second. */
+  float max_velocity = 0.0f;
+};
+
+/**
+ * Advance one closed-domain smoke state using compiled Mantaflow kernels.
+ *
+ * The complete frame, including all internal substeps, remains in Mantaflow storage. No modifier,
+ * Python script, disk cache, global solver singleton, or retained solver pointer is used. On
+ * failure, the caller's buffers are not modified and error_message describes the failure.
+ */
+bool manta_gas_simulation_step(const MantaGasState &state,
+                               const MantaGasStepSettings &settings,
+                               MantaGasStepDiagnostics &diagnostics,
+                               std::string &error_message);
+
+}  // namespace blender
diff --git a/intern/mantaflow/intern/manta_gas_layout.h b/intern/mantaflow/intern/manta_gas_layout.h
new file mode 100644
--- /dev/null
+++ b/intern/mantaflow/intern/manta_gas_layout.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstddef>
+
+namespace blender::manta_gas {
+
+/** Mantaflow dense-grid indexing: X is fastest, followed by Y and then Z. */
+inline std::size_t grid_index(const int size_x,
+                              const int size_y,
+                              const int x,
+                              const int y,
+                              const int z)
+{
+  return static_cast<std::size_t>(x) +
+         static_cast<std::size_t>(size_x) *
+             (static_cast<std::size_t>(y) +
+              static_cast<std::size_t>(size_y) * static_cast<std::size_t>(z));
+}
+
+}  // namespace blender::manta_gas
diff --git a/intern/mantaflow/intern/manta_gas_step_driver.h b/intern/mantaflow/intern/manta_gas_step_driver.h
new file mode 100644
--- /dev/null
+++ b/intern/mantaflow/intern/manta_gas_step_driver.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <optional>
+
+namespace blender::manta_gas {
+
+/**
+ * Frame-local CFL substep scheduler.
+ *
+ * This class deliberately owns no solver state. It only accounts for time within one node call,
+ * which makes the policy testable without Blender or Mantaflow and keeps all physical state in the
+ * explicit grids supplied by the caller.
+ */
+class GasStepDriver {
+ public:
+  GasStepDriver(const double frame_time, const double cfl, const int max_substeps)
+      : frame_time_(frame_time), cfl_(cfl), max_substeps_(max_substeps)
+  {
+    valid_ = std::isfinite(frame_time_) && frame_time_ >= 0.0 && std::isfinite(cfl_) && cfl_ > 0.0 &&
+             max_substeps_ > 0;
+  }
+
+  bool valid() const
+  {
+    return valid_;
+  }
+
+  bool finished() const
+  {
+    return valid_ && remaining() <= time_epsilon();
+  }
+
+  int substeps() const
+  {
+    return substeps_;
+  }
+
+  double simulated_time() const
+  {
+    return simulated_time_;
+  }
+
+  double remaining() const
+  {
+    return std::max(0.0, frame_time_ - simulated_time_);
+  }
+
+  /**
+   * Return the next timestep, or nullopt if the frame is finished, the velocity is invalid, the
+   * timestep underflows, or taking another step would exceed the configured substep limit.
+   */
+  std::optional<float> next_dt(const float max_velocity) const
+  {
+    if (!valid_ || finished() || substeps_ >= max_substeps_) {
+      return std::nullopt;
+    }
+    if (!std::isfinite(max_velocity) || max_velocity < 0.0f) {
+      return std::nullopt;
+    }
+
+    double dt = remaining();
+    if (max_velocity > std::numeric_limits<float>::min()) {
+      dt = std::min(dt, cfl_ / static_cast<double>(max_velocity));
+    }
+
+    /* Avoid a tiny trailing substep caused by floating-point round-off at the frame boundary. */
+    if (remaining() - dt <= time_epsilon()) {
+      dt = remaining();
+    }
+    if (!(dt > 0.0) || !std::isfinite(dt)) {
+      return std::nullopt;
+    }
+
+    const float result = static_cast<float>(dt);
+    if (!(result > 0.0f) || !std::isfinite(result)) {
+      return std::nullopt;
+    }
+    return result;
+  }
+
+  bool commit(const float dt)
+  {
+    const double float_roundoff = std::numeric_limits<float>::epsilon() *
+                                  std::max(1.0, frame_time_) * 2.0;
+    if (!valid_ || finished() || substeps_ >= max_substeps_ || !(dt > 0.0f) ||
+        !std::isfinite(dt) ||
+        static_cast<double>(dt) > remaining() + time_epsilon() + float_roundoff)
+    {
+      return false;
+    }
+
+    simulated_time_ = std::min(frame_time_, simulated_time_ + static_cast<double>(dt));
+    ++substeps_;
+    return true;
+  }
+
+ private:
+  double time_epsilon() const
+  {
+    return std::numeric_limits<double>::epsilon() * std::max(1.0, frame_time_) * 8.0;
+  }
+
+  double frame_time_ = 0.0;
+  double cfl_ = 0.0;
+  int max_substeps_ = 0;
+  bool valid_ = false;
+  int substeps_ = 0;
+  double simulated_time_ = 0.0;
+};
+
+}  // namespace blender::manta_gas
diff --git a/intern/mantaflow/intern/manta_gas_step_API.cpp b/intern/mantaflow/intern/manta_gas_step_API.cpp
new file mode 100644
--- /dev/null
+++ b/intern/mantaflow/intern/manta_gas_step_API.cpp
@@ -0,0 +1,313 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "manta_gas_step_API.h"
+
+#include "manta_gas_step_driver.h"
+
+#include "manta.h"
+#include "fluidsolver.h"
+#include "grid.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace Manta {
+
+/* Direct compiled entry points from extern/mantaflow/preprocessed/plugin/*.cpp. */
+void advectSemiLagrange(const FlagGrid *flags,
+                        const MACGrid *vel,
+                        GridBase *grid,
+                        int order,
+                        Real strength,
+                        int orderSpace,
+                        bool openBounds,
+                        int boundaryWidth,
+                        int clampMode,
+                        int orderTrace);
+
+void addBuoyancy(const FlagGrid &flags,
+                 const Grid<Real> &density,
+                 MACGrid &vel,
+                 Vec3 gravity,
+                 Real coefficient,
+                 bool scale);
+
+void setWallBcs(const FlagGrid &flags,
+                MACGrid &vel,
+                const MACGrid *obvel,
+                const MACGrid *fractions,
+                const Grid<Real> *phiObs,
+                int boundaryWidth);
+
+void solvePressure(MACGrid &vel,
+                   Grid<Real> &pressure,
+                   const FlagGrid &flags,
+                   Real cgAccuracy,
+                   const Grid<Real> *phi,
+                   const Grid<Real> *perCellCorr,
+                   const MACGrid *fractions,
+                   const MACGrid *obvel,
+                   Real gfClamp,
+                   Real cgMaxIterFac,
+                   bool precondition,
+                   int preconditioner,
+                   bool enforceCompatibility,
+                   bool useL2Norm,
+                   bool zeroPressureFixing,
+                   const Grid<Real> *curv,
+                   Real surfTens,
+                   Grid<Real> *retRhs);
+
+}  // namespace Manta
+
+namespace blender {
+namespace {
+
+constexpr int pressure_preconditioner_mic = 1;  // Manta::PcMIC from plugin/pressure.cpp.
+
+std::size_t checked_cell_count(const MantaGasExtent3 &resolution)
+{
+  if (resolution.x < 4 || resolution.y < 4 || resolution.z < 4) {
+    throw std::runtime_error("Gas Simulation Step requires a 3D resolution of at least 4^3.");
+  }
+
+  const std::size_t x = static_cast<std::size_t>(resolution.x);
+  const std::size_t y = static_cast<std::size_t>(resolution.y);
+  const std::size_t z = static_cast<std::size_t>(resolution.z);
+  if (x > std::numeric_limits<std::size_t>::max() / y ||
+      x * y > std::numeric_limits<std::size_t>::max() / z)
+  {
+    throw std::runtime_error("Gas Simulation Step resolution overflows the grid size.");
+  }
+  return x * y * z;
+}
+
+void validate_buffers(const MantaGasState &state, const std::size_t cell_count)
+{
+  if (!state.density || !state.temperature || !state.velocity || !state.pressure) {
+    throw std::runtime_error("Gas Simulation Step received a null grid buffer.");
+  }
+
+  for (std::size_t i = 0; i < cell_count; ++i) {
+    if (!std::isfinite(state.density[i]) || !std::isfinite(state.temperature[i]) ||
+        !std::isfinite(state.pressure[i]) || !std::isfinite(state.velocity[i].x) ||
+        !std::isfinite(state.velocity[i].y) || !std::isfinite(state.velocity[i].z))
+    {
+      throw std::runtime_error("Gas Simulation Step input contains a non-finite value.");
+    }
+  }
+}
+
+void validate_settings(const MantaGasStepSettings &settings)
+{
+  if (!std::isfinite(settings.delta_time) || settings.delta_time < 0.0f ||
+      !std::isfinite(settings.cfl) || settings.cfl <= 0.0f || settings.max_substeps < 1)
+  {
+    throw std::runtime_error("Gas Simulation Step has invalid time-step settings.");
+  }
+  if (!std::isfinite(settings.gravity.x) || !std::isfinite(settings.gravity.y) ||
+      !std::isfinite(settings.gravity.z) || !std::isfinite(settings.density_buoyancy) ||
+      !std::isfinite(settings.heat_buoyancy) || !std::isfinite(settings.pressure_accuracy) ||
+      settings.pressure_accuracy <= 0.0f || !std::isfinite(settings.pressure_iteration_factor) ||
+      settings.pressure_iteration_factor <= 0.0f)
+  {
+    throw std::runtime_error("Gas Simulation Step has invalid force or pressure settings.");
+  }
+}
+
+float max_mac_velocity(const Manta::MACGrid &velocity)
+{
+  double max_squared = 0.0;
+  const Manta::Vec3i extent = velocity.getSize();
+  const Manta::IndexInt size = static_cast<Manta::IndexInt>(extent.x) *
+                               static_cast<Manta::IndexInt>(extent.y) *
+                               static_cast<Manta::IndexInt>(extent.z);
+  for (Manta::IndexInt i = 0; i < size; ++i) {
+    const Manta::Vec3 &value = velocity[i];
+    const double x = static_cast<double>(value.x);
+    const double y = static_cast<double>(value.y);
+    const double z = static_cast<double>(value.z);
+    if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z)) {
+      return std::numeric_limits<float>::infinity();
+    }
+    max_squared = std::max(max_squared, x * x + y * y + z * z);
+  }
+  return static_cast<float>(std::sqrt(max_squared));
+}
+
+bool grids_are_finite(const Manta::Grid<Manta::Real> &density,
+                      const Manta::Grid<Manta::Real> &temperature,
+                      const Manta::Grid<Manta::Real> &pressure,
+                      const Manta::MACGrid &velocity)
+{
+  const Manta::Vec3i extent = density.getSize();
+  const Manta::IndexInt size = static_cast<Manta::IndexInt>(extent.x) *
+                               static_cast<Manta::IndexInt>(extent.y) *
+                               static_cast<Manta::IndexInt>(extent.z);
+  for (Manta::IndexInt i = 0; i < size; ++i) {
+    if (!std::isfinite(static_cast<double>(density[i])) ||
+        !std::isfinite(static_cast<double>(temperature[i])) ||
+        !std::isfinite(static_cast<double>(pressure[i])))
+    {
+      return false;
+    }
+  }
+  return std::isfinite(max_mac_velocity(velocity));
+}
+
+void advect(Manta::FlagGrid &flags,
+            Manta::MACGrid &velocity,
+            Manta::GridBase &grid)
+{
+  Manta::advectSemiLagrange(
+      &flags, &velocity, &grid, 2, 1.0, 1, false, -1, 2, 1);
+}
+
+}  // namespace
+
+bool manta_gas_simulation_step(const MantaGasState &state,
+                               const MantaGasStepSettings &settings,
+                               MantaGasStepDiagnostics &diagnostics,
+                               std::string &error_message)
+{
+  diagnostics = {};
+  error_message.clear();
+
+  try {
+    const std::size_t cell_count = checked_cell_count(state.resolution);
+    validate_buffers(state, cell_count);
+    validate_settings(settings);
+
+    manta_gas::GasStepDriver driver(settings.delta_time, settings.cfl, settings.max_substeps);
+    if (!driver.valid()) {
+      throw std::runtime_error("Gas Simulation Step could not initialize its frame scheduler.");
+    }
+    if (driver.finished()) {
+      return true;
+    }
+
+    /* All objects are local to this call. In particular, no state is shared between zones. */
+    Manta::FluidSolver solver(
+        Manta::Vec3i(state.resolution.x, state.resolution.y, state.resolution.z));
+    Manta::FlagGrid flags(&solver);
+    Manta::Grid<Manta::Real> density(&solver);
+    Manta::Grid<Manta::Real> temperature(&solver);
+    Manta::Grid<Manta::Real> pressure(&solver);
+    Manta::Grid<Manta::Vec3> centered_velocity(&solver);
+    Manta::MACGrid velocity(&solver);
+
+    for (std::size_t i = 0; i < cell_count; ++i) {
+      density[i] = static_cast<Manta::Real>(state.density[i]);
+      temperature[i] = static_cast<Manta::Real>(state.temperature[i]);
+      pressure[i] = static_cast<Manta::Real>(state.pressure[i]);
+      centered_velocity[i] = Manta::Vec3(static_cast<Manta::Real>(state.velocity[i].x),
+                                         static_cast<Manta::Real>(state.velocity[i].y),
+                                         static_cast<Manta::Real>(state.velocity[i].z));
+    }
+    Manta::resampleVec3ToMac(centered_velocity, velocity);
+
+    /* Match a minimal closed gas domain: boundary cells are obstacles, interior cells are fluid. */
+    flags.initDomain(0);
+    flags.fillGrid();
+
+    MantaGasStepDiagnostics local_diagnostics;
+    while (!driver.finished()) {
+      const float max_velocity = max_mac_velocity(velocity);
+      const std::optional<float> next_dt = driver.next_dt(max_velocity);
+      if (!next_dt.has_value()) {
+        if (driver.substeps() >= settings.max_substeps) {
+          throw std::runtime_error(
+              "Gas Simulation Step exhausted its substep limit; the input state was not changed.");
+        }
+        throw std::runtime_error("Gas Simulation Step could not schedule a finite CFL timestep.");
+      }
+
+      /* FluidSolver::step() is intentionally not used as a physics operator. The node owns time. */
+      solver.mDt = static_cast<Manta::Real>(*next_dt);
+      local_diagnostics.max_velocity = std::max(local_diagnostics.max_velocity, max_velocity);
+
+      /* Basic legacy smoke ordering, with explicit compiled operators instead of Python scripts. */
+      advect(flags, velocity, density);
+      advect(flags, velocity, temperature);
+      advect(flags, velocity, velocity);
+
+      if (settings.heat_buoyancy != 0.0f) {
+        Manta::addBuoyancy(flags,
+                           temperature,
+                           velocity,
+                           Manta::Vec3(settings.gravity.x, settings.gravity.y, settings.gravity.z),
+                           static_cast<Manta::Real>(settings.heat_buoyancy),
+                           false);
+      }
+      if (settings.density_buoyancy != 0.0f) {
+        Manta::addBuoyancy(flags,
+                           density,
+                           velocity,
+                           Manta::Vec3(settings.gravity.x, settings.gravity.y, settings.gravity.z),
+                           static_cast<Manta::Real>(settings.density_buoyancy),
+                           false);
+      }
+
+      Manta::setWallBcs(flags, velocity, nullptr, nullptr, nullptr, 0);
+
+      /* PcMIC avoids pressure.cpp's process-global static multigrid preconditioner cache. */
+      Manta::solvePressure(velocity,
+                           pressure,
+                           flags,
+                           static_cast<Manta::Real>(settings.pressure_accuracy),
+                           nullptr,
+                           nullptr,
+                           nullptr,
+                           nullptr,
+                           static_cast<Manta::Real>(1.0e-4),
+                           static_cast<Manta::Real>(settings.pressure_iteration_factor),
+                           true,
+                           pressure_preconditioner_mic,
+                           false,
+                           false,
+                           true,
+                           nullptr,
+                           static_cast<Manta::Real>(0.0),
+                           nullptr);
+
+      if (!grids_are_finite(density, temperature, pressure, velocity)) {
+        throw std::runtime_error("Mantaflow produced a non-finite gas state.");
+      }
+      if (!driver.commit(*next_dt)) {
+        throw std::runtime_error("Gas Simulation Step rejected an internal timestep.");
+      }
+    }
+
+    Manta::resampleMacToVec3(velocity, centered_velocity);
+    for (std::size_t i = 0; i < cell_count; ++i) {
+      if (!std::isfinite(static_cast<double>(centered_velocity[i].x)) ||
+          !std::isfinite(static_cast<double>(centered_velocity[i].y)) ||
+          !std::isfinite(static_cast<double>(centered_velocity[i].z)))
+      {
+        throw std::runtime_error("Mantaflow produced a non-finite centered velocity.");
+      }
+      state.density[i] = static_cast<float>(density[i]);
+      state.temperature[i] = static_cast<float>(temperature[i]);
+      state.pressure[i] = static_cast<float>(pressure[i]);
+      state.velocity[i] = {static_cast<float>(centered_velocity[i].x),
+                           static_cast<float>(centered_velocity[i].y),
+                           static_cast<float>(centered_velocity[i].z)};
+    }
+
+    local_diagnostics.substeps = driver.substeps();
+    local_diagnostics.simulated_time = static_cast<float>(driver.simulated_time());
+    diagnostics = local_diagnostics;
+    return true;
+  }
+  catch (const std::exception &error) {
+    error_message = error.what();
+  }
+  catch (...) {
+    error_message = "Unknown Mantaflow gas-step failure.";
+  }
+  return false;
+}
+
+}  // namespace blender
