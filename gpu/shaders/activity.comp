// Mark every storage slot that holds smoke, heat, or (above its threshold) velocity, and record
// each slot's largest velocity component. Mirrors the CPU reference's activity test and
// max_speed(); the flags decide the next topology and the speeds the next time step.
#version 450
layout(local_size_x = 64) in;

layout(push_constant) uniform Params
{
  int voxels_per_brick;
  int count;
  float scalar_threshold;
  float velocity_threshold;
}
P;
layout(std430, binding = 1) readonly buffer Density { float density[]; };
layout(std430, binding = 2) readonly buffer Temperature { float temperature[]; };
layout(std430, binding = 3) readonly buffer U { float u[]; };
layout(std430, binding = 4) readonly buffer V { float v[]; };
layout(std430, binding = 5) readonly buffer W { float w[]; };
layout(std430, binding = 6) buffer Flags { uint flags[]; };
/* Bit patterns of non-negative floats order like the floats, so an integer maximum works. */
layout(std430, binding = 7) buffer Speeds { uint speed_bits[]; };

void main()
{
  int i = int(gl_GlobalInvocationID.x);
  if (i >= P.count) {
    return;
  }
  bool has_content = abs(density[i]) > P.scalar_threshold ||
                abs(temperature[i]) > P.scalar_threshold ||
                abs(u[i]) > P.velocity_threshold || abs(v[i]) > P.velocity_threshold ||
                abs(w[i]) > P.velocity_threshold;
  if (has_content) {
    atomicOr(flags[i / P.voxels_per_brick], 1u);
  }
  float speed = max(abs(u[i]), max(abs(v[i]), abs(w[i])));
  if (speed > 0.0) {
    atomicMax(speed_bits[i / P.voxels_per_brick], floatBitsToUint(speed));
  }
}
