// First-order semi-Lagrangian advection. P.a = (offset of the advected channel, dt);
// P.flags.x selects the midpoint trace. With P.flags.y set, the lowest and highest of the eight
// values the trace interpolated are stored for the MacCormack correction, which then need not
// repeat the trace.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define U b4
#define V b5
#define W b6
#define SOURCE b7
#define RESULT b8
/* Two floats per voxel: lowest and highest. Lowest above highest marks a trace that read a
 * voxel that has no storage or is solid. */
layout(std430, binding = 10) writeonly buffer Bounds { float bounds[]; };

/* One brick-table lookup per corner; missing voxels read 0, as in the CPU reference. */
#define SAMPLE(name, channel) \
  float name##_at(ivec3 c) \
  { \
    int i = index_of(c); \
    return i < 0 ? 0.0 : channel[i]; \
  } \
  float name(vec3 p, vec3 offset) \
  { \
    vec3 f = p - offset; \
    vec3 base = floor(f); \
    ivec3 i = ivec3(base); \
    vec3 t = f - base; \
    float f000 = name##_at(i); \
    float f100 = name##_at(i + ivec3(1, 0, 0)); \
    float f010 = name##_at(i + ivec3(0, 1, 0)); \
    float f110 = name##_at(i + ivec3(1, 1, 0)); \
    float f001 = name##_at(i + ivec3(0, 0, 1)); \
    float f101 = name##_at(i + ivec3(1, 0, 1)); \
    float f011 = name##_at(i + ivec3(0, 1, 1)); \
    float f111 = name##_at(i + ivec3(1, 1, 1)); \
    float c00 = f000 + (f100 - f000) * t.x; \
    float c10 = f010 + (f110 - f010) * t.x; \
    float c01 = f001 + (f101 - f001) * t.x; \
    float c11 = f011 + (f111 - f011) * t.x; \
    float c0 = c00 + (c10 - c00) * t.y; \
    float c1 = c01 + (c11 - c01) * t.y; \
    return c0 + (c1 - c0) * t.z; \
  }

SAMPLE(sample_u, U)
SAMPLE(sample_v, V)
SAMPLE(sample_w, W)
SAMPLE(sample_source, SOURCE)

vec3 velocity_at(vec3 p)
{
  return vec3(sample_u(p, vec3(0.0, 0.5, 0.5)),
              sample_v(p, vec3(0.5, 0.0, 0.5)),
              sample_w(p, vec3(0.5, 0.5, 0.0)));
}

/* Follow the velocity from p for `step` seconds (negative: backwards). With P.flags.x set, use
 * the velocity half way along a first, single-stage trace. Mirrors trace() in the CPU
 * reference. */
vec3 trace(vec3 p, float step)
{
  vec3 velocity = velocity_at(p);
  if (P.flags.x != 0) {
    float half_step = 0.5 * step;
    velocity = velocity_at(p + half_step * velocity);
  }
  return p + step * velocity;
}

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  if (cell_type[index] == CELL_SOLID) {
    RESULT[index] = 0.0;
    return;
  }
  vec3 p = vec3(coords_of(index)) + P.a.xyz;
  vec3 from = trace(p, -P.a.w);
  if (P.flags.y == 0) {
    RESULT[index] = sample_source(from, P.a.xyz);
    return;
  }

  /* The same interpolation as sample_source, keeping the corner values. */
  vec3 f = from - P.a.xyz;
  vec3 base = floor(f);
  ivec3 corner_base = ivec3(base);
  vec3 t = f - base;
  float value[8];
  bool stored = true;
  float lowest = 0.0, highest = 0.0;
  for (int corner = 0; corner < 8; ++corner) {
    int i = index_of(corner_base + ivec3(corner & 1, (corner >> 1) & 1, (corner >> 2) & 1));
    /* Solid cells hold zero; next to them the correction is not applied either. */
    stored = stored && i >= 0 && cell_type[i] != CELL_SOLID;
    value[corner] = i < 0 ? 0.0 : SOURCE[i];
    lowest = corner == 0 ? value[corner] : min(lowest, value[corner]);
    highest = corner == 0 ? value[corner] : max(highest, value[corner]);
  }
  float c00 = value[0] + (value[1] - value[0]) * t.x;
  float c10 = value[2] + (value[3] - value[2]) * t.x;
  float c01 = value[4] + (value[5] - value[4]) * t.x;
  float c11 = value[6] + (value[7] - value[6]) * t.x;
  float c0 = c00 + (c10 - c00) * t.y;
  float c1 = c01 + (c11 - c01) * t.y;
  RESULT[index] = c0 + (c1 - c0) * t.z;
  bounds[2 * index] = stored ? lowest : 1.0;
  bounds[2 * index + 1] = stored ? highest : 0.0;
}
