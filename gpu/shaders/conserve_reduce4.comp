// conserve_reduce for the fused scalar pass: work group k reduces channel k's sums written by
// maccormack4 and stores its factor and sign at partials[2k], partials[2k + 1].
#version 450
#extension GL_GOOGLE_include_directive : enable
#define NO_FLOAT_CHANNELS
#include "common.glsl"
layout(std430, binding = 16) buffer Partials { float partials[]; };

shared float group_sums[3][64];

void main()
{
  uint l = gl_LocalInvocationID.x;
  int channel = int(gl_WorkGroupID.x);
  float sums[3] = float[3](0.0, 0.0, 0.0);
  for (int g = int(l); g < P.flags.x; g += 64) {
    for (int k = 0; k < 3; ++k) {
      sums[k] += partials[8 + 12 * g + 3 * channel + k];
    }
  }
  for (int k = 0; k < 3; ++k) {
    group_sums[k][l] = sums[k];
  }
  for (uint width = 32u; width > 0u; width >>= 1) {
    barrier();
    if (l < width) {
      for (int k = 0; k < 3; ++k) {
        group_sums[k][l] += group_sums[k][l + width];
      }
    }
  }
  if (l == 0u) {
    float excess = group_sums[0][0];
    float pool = excess > 0.0 ? group_sums[1][0] : group_sums[2][0];
    partials[2 * channel] = excess == 0.0 || pool == 0.0 ? 1.0 : max(0.0, 1.0 - abs(excess) / pool);
    partials[2 * channel + 1] = excess > 0.0 ? 1.0 : -1.0;
  }
}
