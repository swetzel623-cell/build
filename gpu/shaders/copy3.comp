// Copy three channels. Used to keep the unprojected velocity for advection-reflection.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  b7[index] = QV(float(b4[index]));
  b8[index] = QV(float(b5[index]));
  b9[index] = QV(float(b6[index]));
}
