// Divergence of fluid cells, scaled by P.a.x (-1 gives the pressure right-hand side). With
// P.flags.x, minus the divergence the flow should have: EXPANSION + P.a.y * BURN (gas release).
// Mirrors project in the CPU reference.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define U b4
#define V b5
#define W b6
#define RESULT b7
#define EXPANSION b8
#define BURN b9

float fetch_u(ivec3 c) { int i = index_of(c); return i < 0 ? 0.0 : float(U[i]); }
float fetch_v(ivec3 c) { int i = index_of(c); return i < 0 ? 0.0 : float(V[i]); }
float fetch_w(ivec3 c) { int i = index_of(c); return i < 0 ? 0.0 : float(W[i]); }

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  if (cell_type[index] != CELL_FLUID) {
    RESULT[index] = QP(0.0);
    return;
  }
  ivec3 c = coords_of(index);
  float divergence = fetch_u(c + ivec3(1, 0, 0)) - float(U[index]) + fetch_v(c + ivec3(0, 1, 0)) -
                     float(V[index]) + fetch_w(c + ivec3(0, 0, 1)) - float(W[index]);
  if (P.flags.x != 0) {
    float target = float(EXPANSION[index]) + P.a.y * float(BURN[index]);
    divergence = divergence - target;
  }
  RESULT[index] = QP(P.a.x * divergence);
}
