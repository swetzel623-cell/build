// Subtract the pressure gradient from every face that borders a fluid cell. Faces touching a
// solid keep the obstacle velocity the walls kernel gave them.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define PRESSURE b4
#define U b5
#define V b6
#define W b7

float pressure_at(ivec3 c)
{
  return type_at(c) == CELL_FLUID ? float(PRESSURE[index_of(c)]) : 0.0;
}

float corrected(float face, uint here, float upper, ivec3 below)
{
  uint lower_type = type_at(below);
  if (here == CELL_SOLID || lower_type == CELL_SOLID) {
    return face;
  }
  if (here == CELL_FLUID || lower_type == CELL_FLUID) {
    return face - (upper - pressure_at(below));
  }
  return face;
}

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  ivec3 c = coords_of(index);
  uint here = cell_type[index];
  float upper = here == CELL_FLUID ? float(PRESSURE[index]) : 0.0;
  U[index] = QV(corrected(float(U[index]), here, upper, c - ivec3(1, 0, 0)));
  V[index] = QV(corrected(float(V[index]), here, upper, c - ivec3(0, 1, 0)));
  W[index] = QV(corrected(float(W[index]), here, upper, c - ivec3(0, 0, 1)));
}
