// Start of a step: zero the scalars of solid cells, then apply the sources. Mirrors inject in
// the CPU reference. P.a.x = dt; P.flags.x = 0 to raise, 1 to add; P.flags.y = source channels
// (0, 4, or 7: density, temperature, fuel, expansion, then velocity); P.flags.z = values per
// source channel. Sets EXPANSION from the sources and clears BURN.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define DENSITY b4
#define TEMPERATURE b5
#define U b6
#define V b7
#define W b8
#define FUEL b9
layout(std430, binding = 12) buffer B12 { float flame[]; };
layout(std430, binding = 13) buffer B13 { float EXPANSION[]; };
layout(std430, binding = 14) buffer B14 { float BURN[]; };
/* Per brick of the domain: the source's slot, or -1. */
layout(std430, binding = 10) readonly buffer SourceTable { int source_table[]; };
layout(std430, binding = 11) readonly buffer SourceValues { float source[]; };

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  EXPANSION[index] = 0.0;
  BURN[index] = 0.0;
  if (cell_type[index] == CELL_SOLID) {
    DENSITY[index] = 0.0;
    TEMPERATURE[index] = 0.0;
    FUEL[index] = 0.0;
    flame[index] = 0.0;
    return;
  }
  if (P.flags.y == 0) {
    return;
  }
  int size = P.extent.w;
  int per_brick = size * size * size;
  int slot = index / per_brick;
  int source_slot = source_table[brick_coords[slot].w];
  if (source_slot < 0) {
    return;
  }
  int at = source_slot * per_brick + (index - slot * per_brick);
  int stride = P.flags.z;
  float density = source[at];
  float temperature = source[stride + at];
  float fuel = source[2 * stride + at];
  float expansion = source[3 * stride + at];
  EXPANSION[index] = expansion;
  if (P.flags.x == 0) {
    if (density != 0.0) {
      DENSITY[index] = max(DENSITY[index], density);
    }
    if (temperature != 0.0) {
      TEMPERATURE[index] = max(TEMPERATURE[index], temperature);
    }
    if (fuel != 0.0) {
      FUEL[index] = max(FUEL[index], fuel);
    }
  }
  else {
    DENSITY[index] += density * P.a.x;
    TEMPERATURE[index] += temperature * P.a.x;
    FUEL[index] += fuel * P.a.x;
  }
  if (P.flags.y >= 7 &&
      (density != 0.0 || temperature != 0.0 || fuel != 0.0 || expansion != 0.0))
  {
    U[index] = source[4 * stride + at];
    V[index] = source[5 * stride + at];
    W[index] = source[6 * stride + at];
  }
}
