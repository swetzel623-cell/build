// One Jacobi sweep of the pressure Poisson system. Open neighbors have pressure zero.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define RHS b4
#define PRESSURE b5
#define RESULT b6

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  if (cell_type[index] != CELL_FLUID) {
    RESULT[index] = 0.0;
    return;
  }
  ivec3 c = coords_of(index);
  const ivec3 offsets[6] = ivec3[6](ivec3(-1, 0, 0), ivec3(1, 0, 0), ivec3(0, -1, 0),
                                    ivec3(0, 1, 0), ivec3(0, 0, -1), ivec3(0, 0, 1));
  float sum = 0.0;
  int diagonal = 0;
  for (int n = 0; n < 6; ++n) {
    ivec3 neighbor = c + offsets[n];
    uint type = type_at(neighbor);
    if (type == CELL_SOLID) {
      continue;
    }
    ++diagonal;
    if (type == CELL_FLUID) {
      sum += PRESSURE[index_of(neighbor)];
    }
  }
  RESULT[index] = diagonal > 0 ? (RHS[index] + sum) / float(diagonal) : 0.0;
}
