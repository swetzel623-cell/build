// MacCormack correction of the three velocity components in one dispatch. Mirrors
// maccormack.comp per component. P.a.w = dt, P.flags.x midpoint trace. Bindings: 4-6 advecting
// velocity, 7-9 sources, 10-12 forward results, 13-14 + 16 results (u, v, w), 15 bounds.
#version 450
#extension GL_GOOGLE_include_directive : enable
#define NO_FLOAT_CHANNELS
#include "common.glsl"
#include "advect_trace.glsl"
layout(std430, binding = 7) readonly buffer S0 { CH_T s0[]; };
layout(std430, binding = 8) readonly buffer S1 { CH_T s1[]; };
layout(std430, binding = 9) readonly buffer S2 { CH_T s2[]; };
layout(std430, binding = 10) readonly buffer F0 { CH_T f0[]; };
layout(std430, binding = 11) readonly buffer F1 { CH_T f1[]; };
layout(std430, binding = 12) readonly buffer F2 { CH_T f2[]; };
layout(std430, binding = 13) writeonly buffer R0 { CH_T r0[]; };
layout(std430, binding = 14) writeonly buffer R1 { CH_T r1[]; };
layout(std430, binding = 16) writeonly buffer R2 { CH_T r2[]; };
layout(std430, binding = 15) readonly buffer Bounds { float bounds[]; };

float source(int k, int i)
{
  return k == 0 ? float(s0[i]) : k == 1 ? float(s1[i]) : float(s2[i]);
}
float forward_at(int k, int i)
{
  return k == 0 ? float(f0[i]) : k == 1 ? float(f1[i]) : float(f2[i]);
}
void store(int k, int i, float v)
{
  if (k == 0) r0[i] = STORE(v);
  else if (k == 1) r1[i] = STORE(v);
  else r2[i] = STORE(v);
}

float corrected_value(int k, int index, uint type, ivec3 c)
{
  if (type == CELL_SOLID) {
    return 0.0;
  }
  float forward = forward_at(k, index);
  if (type != CELL_FLUID) {
    return forward;
  }
  ivec3 below = c;
  below[k] -= 1;
  if (type_at(below) != CELL_FLUID) {
    return forward;
  }
  float lowest = bounds[8 * index + 2 * k], highest = bounds[8 * index + 2 * k + 1];
  if (lowest > highest) {
    return forward;
  }
  vec3 offset = vec3(0.5);
  offset[k] = 0.0;
  vec3 to = trace(vec3(c) + offset, P.a.w);
  vec3 f = to - offset;
  vec3 base = floor(f);
  ivec3 corner_base = ivec3(base);
  vec3 t = f - base;
  float value[8];
  for (int corner = 0; corner < 8; ++corner) {
    int i = index_of(corner_base + ivec3(corner & 1, (corner >> 1) & 1, (corner >> 2) & 1));
    if (i < 0 || cell_type[i] == CELL_SOLID) {
      return forward;
    }
    value[corner] = forward_at(k, i);
  }
  float backward = lerp8(value, t);
  float corrected = forward + 0.5 * (source(k, index) - backward);
  return min(max(corrected, lowest), highest);
}

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  uint type = cell_type[index];
  ivec3 c = coords_of(index);
  for (int k = 0; k < 3; ++k) {
    store(k, index, corrected_value(k, index, type, c));
  }
}
