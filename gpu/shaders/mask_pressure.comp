// Cells that are not fluid have no pressure unknown; clear what a topology change left there.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define PRESSURE b4

void main()
{
  int index;
  if (!voxel_in_range(index)) {
    return;
  }
  /* a.x is 1 to keep the previous pressure as the initial guess, 0 to start from zero. */
  PRESSURE[index] = QP(cell_type[index] != CELL_FLUID ? 0.0 : P.a.x * float(PRESSURE[index]));
}
