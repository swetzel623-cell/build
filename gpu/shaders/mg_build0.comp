// Galerkin coarse operator for piecewise-constant aggregation of 2x2x2 finer cells.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "mg_common.glsl"
layout(std430, binding = 3) readonly buffer Links { uint links[]; };
layout(std430, binding = 4) writeonly buffer CoarseOperator { vec4 coarse_op[]; };

void main()
{
  int index;
  if (!cell_in_range(P.lb, index)) {
    return;
  }
  ivec3 c = level_coords(P.lb, index);
  float diagonal = 0.0;
  vec3 weights = vec3(0.0);
  for (int child = 0; child < 8; ++child) {
    ivec3 offset = ivec3(child & 1, (child >> 1) & 1, (child >> 2) & 1);
    int i = level_index(P.la, 2 * c + offset);
    if (i < 0) {
      continue;
    }
    uint packed = links[i];
    if (!fine_is_fluid(packed)) {
      continue;
    }
    diagonal += fine_diagonal(packed);
    for (int axis = 0; axis < 3; ++axis) {
      float weight = fine_linked(packed, 2 * axis) ? 1.0 : 0.0;
      if (offset[axis] != 0) {
        /* Coupling inside the aggregate: it leaves the off-diagonals of both its cells. */
        diagonal -= 2.0 * weight;
      }
      else {
        weights[axis] += weight;
      }
    }
  }
  coarse_op[index] = vec4(diagonal, weights);
}
