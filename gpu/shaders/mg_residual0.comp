// Residual of the pressure system on the voxel level.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "mg_common.glsl"
layout(std430, binding = 3) readonly buffer Links { uint links[]; };
layout(std430, binding = 4) readonly buffer Rhs { float rhs[]; };
layout(std430, binding = 5) readonly buffer Values { float x[]; };
layout(std430, binding = 6) writeonly buffer Residual { float residual[]; };

void main()
{
  int index;
  if (!cell_in_range(P.la, index)) {
    return;
  }
  uint packed = links[index];
  if (!fine_is_fluid(packed)) {
    residual[index] = 0.0;
    return;
  }
  ivec3 c = level_coords(P.la, index);
  float sum = 0.0;
  for (int axis = 0; axis < 3; ++axis) {
    if (fine_linked(packed, 2 * axis)) {
      sum += x[level_index(P.la, c - AXES[axis])];
    }
    if (fine_linked(packed, 2 * axis + 1)) {
      sum += x[level_index(P.la, c + AXES[axis])];
    }
  }
  residual[index] = rhs[index] - (fine_diagonal(packed) * x[index] - sum);
}
