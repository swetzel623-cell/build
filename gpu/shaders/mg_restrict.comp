// Between coarse levels: sum the residuals of the 2x2x2 finer cells into the coarser right-hand
// side, and start the coarser unknown at zero. The residual is computed here, not in a pass of
// its own, which saves a dispatch and a buffer.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "mg_common.glsl"
layout(std430, binding = 3) readonly buffer Operator { vec4 op[]; };
layout(std430, binding = 4) readonly buffer Rhs { float rhs[]; };
layout(std430, binding = 5) readonly buffer Values { float x[]; };
layout(std430, binding = 6) writeonly buffer CoarseRhs { float coarse_rhs[]; };
layout(std430, binding = 7) writeonly buffer CoarseValues { float coarse_x[]; };
#include "mg_coarse.glsl"

float fine_residual(int index, ivec3 c)
{
  float diagonal = op[index].x;
  if (!(diagonal > 0.0)) {
    return 0.0;
  }
  return rhs[index] - (diagonal * x[index] - coarse_neighbor_sum(index, c));
}

void main()
{
  int index;
  if (!cell_in_range(P.lb, index)) {
    return;
  }
  ivec3 c = level_coords(P.lb, index);
  float sum = 0.0;
  for (int child = 0; child < 8; ++child) {
    ivec3 fine = 2 * c + ivec3(child & 1, (child >> 1) & 1, (child >> 2) & 1);
    int i = level_index(P.la, fine);
    sum += i < 0 ? 0.0 : fine_residual(i, fine);
  }
  coarse_rhs[index] = sum;
  coarse_x[index] = 0.0;
}
