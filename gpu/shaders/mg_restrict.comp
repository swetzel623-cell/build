// Sum the residuals of the 2x2x2 finer cells into the coarse right-hand side, and start the
// coarse unknown at zero.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "mg_common.glsl"
layout(std430, binding = 4) readonly buffer FineResidual { float fine_residual[]; };
layout(std430, binding = 5) writeonly buffer CoarseRhs { float coarse_rhs[]; };
layout(std430, binding = 6) writeonly buffer CoarseValues { float coarse_x[]; };

void main()
{
  int index;
  if (!cell_in_range(index)) {
    return;
  }
  ivec3 c = level_coords(P.lb, index);
  float sum = 0.0;
  for (int child = 0; child < 8; ++child) {
    int i = level_index(P.la, 2 * c + ivec3(child & 1, (child >> 1) & 1, (child >> 2) & 1));
    sum += i < 0 ? 0.0 : fine_residual[i];
  }
  coarse_rhs[index] = sum;
  coarse_x[index] = 0.0;
}
