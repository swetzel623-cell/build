// One color of a red-black Gauss-Seidel sweep on a coarse level.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "mg_common.glsl"
layout(std430, binding = 3) readonly buffer Operator { vec4 op[]; };
layout(std430, binding = 4) readonly buffer Rhs { float rhs[]; };
layout(std430, binding = 5) buffer Values { float x[]; };
#include "mg_coarse.glsl"

void main()
{
  int index;
  if (!cell_in_range(P.la, index)) {
    return;
  }
  float diagonal = op[index].x;
  if (!(diagonal > 0.0)) {
    return;
  }
  ivec3 c = level_coords(P.la, index);
  if (((c.x + c.y + c.z) & 1) != P.color) {
    return;
  }
  x[index] = QPC((rhs[index] + coarse_neighbor_sum(index, c)) / diagonal);
}
