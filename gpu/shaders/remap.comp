// Move one channel onto a new topology. Bricks that are new start at zero.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "quant.glsl"
layout(local_size_x = 64) in;

layout(push_constant) uniform Params
{
  int voxels_per_brick;
  int count;
}
P;
layout(std430, binding = 1) readonly buffer SlotMap { int old_slot[]; };
layout(std430, binding = 2) readonly buffer Source { CH_T source[]; };
layout(std430, binding = 3) writeonly buffer Target { CH_T target[]; };

void main()
{
  int i = int(gl_GlobalInvocationID.x);
  if (i >= P.count) {
    return;
  }
  int slot = i / P.voxels_per_brick;
  int previous = old_slot[slot];
  target[i] = QS(previous < 0 ? 0.0 :
                             float(source[previous * P.voxels_per_brick + (i - slot * P.voxels_per_brick)]));
}
